{
  "info": {
    "name": "FrutyFenix API",
    "description": "API Backend FrutyFenix - Productos, Inventario, Proveedores y Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5174"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Crear Usuario",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/new",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@test.com\",\n  \"password\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token guardado automaticamente');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@test.com\",\n  \"password\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token guardado automaticamente');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Renovar Token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/renew",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token renovado y guardado');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Ver Todos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/productos",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Crear Producto",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/productos",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Manzana\",\n  \"precio\": 5000,\n  \"descripcion\": \"Manzana roja fresca\"\n}"
            }
          }
        },
        {
          "name": "Ver Por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/productos/ID_AQUI",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "ID_AQUI"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Actualizar Producto",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/productos/ID_AQUI",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "ID_AQUI"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Manzana Golden\",\n  \"precio\": 4500\n}"
            }
          }
        },
        {
          "name": "Eliminar Producto",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/productos/ID_AQUI",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "ID_AQUI"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Inventario",
      "item": [
        {
          "name": "Ver Todo",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/inventario",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Crear Inventario",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/inventario",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_producto\": \"ID_PRODUCTO\",\n  \"calibre\": \"extra\",\n  \"cantidad\": 100\n}"
            }
          }
        },
        {
          "name": "Ver Por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/inventario/ID_AQUI",
              "host": ["{{baseUrl}}"],
              "path": ["inventario", "ID_AQUI"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Eliminar Inventario",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/inventario/ID_AQUI",
              "host": ["{{baseUrl}}"],
              "path": ["inventario", "ID_AQUI"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Proveedores",
      "item": [
        {
          "name": "Ver Todos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/proveedores"
          }
        },
        {
          "name": "Crear Proveedor",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/proveedores",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Frutas del Valle\",\n  \"direccion\": \"Calle Principal #123\",\n  \"correo\": \"contacto@frutasvalle.com\",\n  \"telefono\": \"3001234567\"\n}"
            }
          }
        },
        {
          "name": "Ver Por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/proveedores/ID_AQUI",
              "host": ["{{baseUrl}}"],
              "path": ["proveedores", "ID_AQUI"]
            }
          }
        },
        {
          "name": "Actualizar Proveedor",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/proveedores/ID_AQUI",
              "host": ["{{baseUrl}}"],
              "path": ["proveedores", "ID_AQUI"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Frutas del Valle Updated\",\n  \"telefono\": \"3009876543\"\n}"
            }
          }
        },
        {
          "name": "Eliminar Proveedor",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/proveedores/ID_AQUI",
              "host": ["{{baseUrl}}"],
              "path": ["proveedores", "ID_AQUI"]
            }
          }
        }
      ]
    }
  ]
}
